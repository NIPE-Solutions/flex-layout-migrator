{
  "name": "@nipe-solutions/flex-layout-codemod",
  "version": "2.0.0-beta.0",
  "description": "A safety-first codemod for migrating Angular Flex-Layout templates to native CSS or Tailwind CSS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "ts-node ./src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "if-env -n NODE_ENV=production || husky install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run package:check",
    "package:check": "node scripts/verify-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIPE-Solutions/flex-layout-migrator.git"
  },
  "keywords": [
    "angular",
    "flex-layout",
    "migration",
    "tailwindcss"
  ],
  "author": "Nicholas Petrasek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NIPE-Solutions/flex-layout-migrator/issues"
  },
  "homepage": "https://github.com/NIPE-Solutions/flex-layout-migrator#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "classnames": "^2.5.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "fs-extra": "^11.4.0",
    "p-queue": "^9.3.3",
    "spinnies": "^0.5.1",
    "winston": "^3.19.0"
  },
  "bin": {
    "flex-layout-codemod": "./dist/cli.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.0",
    "@types/spinnies": "^0.5.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
