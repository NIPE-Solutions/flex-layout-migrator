{
  "name": "@nipe-solutions/flex-layout-codemod",
  "version": "2.0.0-beta.1",
  "description": "A safety-first codemod for migrating Angular Flex-Layout templates to native CSS or Tailwind CSS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "architecture:inventory": "node scripts/architecture-inventory.mjs",
    "benchmark:architecture": "node scripts/benchmark/architecture-benchmark.mjs",
    "benchmark:architecture:prepare": "npm run build",
    "clean": "rimraf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "ts-node ./src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run package:check",
    "package:check": "node scripts/verify-package.mjs",
    "changeset": "changeset add",
    "version-packages": "changeset version",
    "release:prepare": "node scripts/release-artifact.mjs",
    "release:verify": "node scripts/release-artifact.mjs --verify-retained",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIPE-Solutions/flex-layout-migrator.git"
  },
  "keywords": [
    "angular",
    "flex-layout",
    "migration",
    "tailwindcss"
  ],
  "author": "Nicholas Petrasek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NIPE-Solutions/flex-layout-migrator/issues"
  },
  "homepage": "https://github.com/NIPE-Solutions/flex-layout-migrator#readme",
  "dependencies": {
    "@angular/compiler": "21.2.22",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "ignore": "5.2.4",
    "winston": "^3.19.0"
  },
  "bin": {
    "flex-layout-codemod": "./dist/cli.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mock-fs": "^5.5.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
