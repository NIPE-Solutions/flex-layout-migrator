{
  "name": "@nipe-solutions/flex-layout-codemod",
  "version": "2.0.0-beta.0",
  "description": "A safety-first codemod for migrating Angular Flex-Layout templates to native CSS or Tailwind CSS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "ts-node ./src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "if-env -n NODE_ENV=production || husky install",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "prettier": "prettier --check 'src/**/*.{js,ts,json}'",
    "prettier:write": "prettier --write 'src/**/*.{js,ts,json}'",
    "verify": "npm run prettier && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIPE-Solutions/flex-layout-migrator.git"
  },
  "keywords": [
    "angular",
    "flex-layout",
    "migration",
    "tailwindcss"
  ],
  "author": "Nicholas Petrasek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NIPE-Solutions/flex-layout-migrator/issues"
  },
  "homepage": "https://github.com/NIPE-Solutions/flex-layout-migrator#readme",
  "dependencies": {
    "@esm2cjs/p-queue": "^7.3.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "classnames": "^2.3.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "commander": "^10.0.1",
    "console-control-strings": "^1.1.0",
    "date-fns": "^2.29.3",
    "figlet": "^1.6.0",
    "fs-extra": "^11.1.1",
    "jsdom": "^21.1.1",
    "ora": "^6.3.0",
    "spinnies": "^0.5.1",
    "winston": "^3.8.2"
  },
  "bin": {
    "flex-layout-codemod": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.0",
    "@types/figlet": "^1.5.6",
    "@types/fs-extra": "^11.0.1",
    "@types/jest": "^29.5.1",
    "@types/jsdom": "^21.1.1",
    "@types/mock-fs": "^4.13.1",
    "@types/node": "^26.4.0",
    "@types/spinnies": "^0.5.0",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "if-env": "^1.0.4",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.2",
    "mock-fs": "^5.2.0",
    "prettier": "^2.8.8",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.4",
    "vitest": "^4.1.11"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  }
}
